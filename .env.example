# Copie este arquivo para .env e preencha com os valores reais
DB_USER=
DB_PASS=

# Segredo do client tecnico Keycloak (Feign interno) — OBRIGATORIO
# Injetado no realm no import (placeholder no realm-clinica.json) e usado pelos
# microsservicos. Sem ele a stack nao sobe. Troque por um valor forte fora de dev.
KEYCLOAK_SERVICE_SECRET=clinica-service-secret

# Provedor de autenticacao service-to-service para o Feign interceptor.
# Padrao: keycloak (matchIfMissing=true no @ConditionalOnProperty da classe
# KeycloakServiceTokenProvider). Deixe descomentado pra confirmar explicitamente.
# Trocar para outro valor (ex.: auth0, okta) exige criar uma nova classe que
# implemente ServiceTokenProvider em cada modulo (integration/<alvo>/) com a
# anotacao @ConditionalOnProperty(name="auth.provider", havingValue="<valor>").
# AUTH_PROVIDER=keycloak
