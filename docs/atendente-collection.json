{
  "info": {
    "name": "Clinica Medica — Atendente",
    "_postman_id": "clinica-atendente-001",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "atendente_id",      "value": "" },
    { "key": "atendente_usuario", "value": "" }
  ],
  "item": [
    {
      "name": "00 - Obter Token ADMIN",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Token ADMIN obtido', () => pm.response.to.have.status(200));",
        "pm.environment.set('token_admin', pm.response.json().access_token);"
      ]}}],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
        "body": { "mode": "urlencoded", "urlencoded": [
          { "key": "grant_type", "value": "password" },
          { "key": "client_id",  "value": "{{client_id}}" },
          { "key": "username",   "value": "{{username_admin}}" },
          { "key": "password",   "value": "{{password_admin}}" }
        ]},
        "url": { "raw": "{{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/token",
          "host": ["{{keycloak_url}}"], "path": ["realms","{{realm}}","protocol","openid-connect","token"] }
      }
    },
    {
      "name": "Atendente — POST create",
      "event": [
        { "listen": "prerequest", "script": { "exec": [
          "pm.collectionVariables.set('atendente_usuario', 'maria.recepcao.'+Date.now());"
        ]}},
        { "listen": "test", "script": { "exec": [
          "pm.test('Criado 201', () => pm.response.to.have.status(201));",
          "pm.test('Tem ID', () => { const j=pm.response.json(); pm.expect(j.id).to.be.a('number'); pm.collectionVariables.set('atendente_id',j.id); });",
          "pm.test('Sem senha no response', () => pm.expect(pm.response.json()).to.not.have.property('senha'));",
          "pm.test('Ativo true', () => pm.expect(pm.response.json().ativo).to.be.true);"
        ]}}
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Maria Recepcao\",\n  \"usuario\": \"{{atendente_usuario}}\",\n  \"senha\": \"senha123\"\n}" },
        "url": { "raw": "{{admin_base_url}}/v1/atendentes", "host": ["{{admin_base_url}}"], "path": ["v1","atendentes"] }
      }
    },
    {
      "name": "Atendente — POST usuario duplicado 409",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('409 Conflict', () => pm.response.to.have.status(409));"
      ]}}],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Outra Recepcao\",\n  \"usuario\": \"{{atendente_usuario}}\",\n  \"senha\": \"qualquer\"\n}" },
        "url": { "raw": "{{admin_base_url}}/v1/atendentes", "host": ["{{admin_base_url}}"], "path": ["v1","atendentes"] }
      }
    },
    {
      "name": "Atendente — POST 400 nome vazio",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
      ]}}],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "body": { "mode": "raw", "raw": "{\"nome\": \"\", \"usuario\": \"\", \"senha\": \"\"}" },
        "url": { "raw": "{{admin_base_url}}/v1/atendentes", "host": ["{{admin_base_url}}"], "path": ["v1","atendentes"] }
      }
    },
    {
      "name": "Atendente — GET list",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "pm.test('Array', () => pm.expect(pm.response.json()).to.be.an('array'));",
        "pm.test('Nenhum tem senha', () => { pm.response.json().forEach(a => pm.expect(a).to.not.have.property('senha')); });"
      ]}}],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": { "raw": "{{admin_base_url}}/v1/atendentes", "host": ["{{admin_base_url}}"], "path": ["v1","atendentes"] }
      }
    },
    {
      "name": "Atendente — PUT update",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "pm.test('Nome atualizado', () => pm.expect(pm.response.json().nome).to.eql('Maria Recepcao Atualizada'));",
        "pm.test('Sem senha', () => pm.expect(pm.response.json()).to.not.have.property('senha'));"
      ]}}],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Maria Recepcao Atualizada\",\n  \"usuario\": \"{{atendente_usuario}}\",\n  \"senha\": \"novaSenha456\"\n}" },
        "url": { "raw": "{{admin_base_url}}/v1/atendentes/{{atendente_id}}", "host": ["{{admin_base_url}}"], "path": ["v1","atendentes","{{atendente_id}}"] }
      }
    },
    {
      "name": "Atendente — PUT 404",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
      ]}}],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "body": { "mode": "raw", "raw": "{\"nome\": \"Ghost\", \"usuario\": \"ghost.user\", \"senha\": \"senha123\"}" },
        "url": { "raw": "{{admin_base_url}}/v1/atendentes/999999", "host": ["{{admin_base_url}}"], "path": ["v1","atendentes","999999"] }
      }
    },
    {
      "name": "Atendente — DELETE",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('204 No Content', () => pm.response.to.have.status(204));"
      ]}}],
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": { "raw": "{{admin_base_url}}/v1/atendentes/{{atendente_id}}", "host": ["{{admin_base_url}}"], "path": ["v1","atendentes","{{atendente_id}}"] }
      }
    },
    {
      "name": "Atendente — DELETE 404",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
      ]}}],
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": { "raw": "{{admin_base_url}}/v1/atendentes/999999", "host": ["{{admin_base_url}}"], "path": ["v1","atendentes","999999"] }
      }
    }
  ]
}
