{
  "info": {
    "name": "Clinica Medica — Relatorios",
    "_postman_id": "clinica-relatorios-001",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "convenio_id",    "value": "" },
    { "key": "data_relatorio", "value": "" }
  ],
  "item": [
    {
      "name": "00 - Obter Token ADMIN",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Token ADMIN obtido', () => pm.response.to.have.status(200));",
        "pm.environment.set('token_admin', pm.response.json().access_token);"
      ]}}],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
        "body": { "mode": "urlencoded", "urlencoded": [
          { "key": "grant_type", "value": "password" },
          { "key": "client_id",  "value": "{{client_id}}" },
          { "key": "username",   "value": "{{username_admin}}" },
          { "key": "password",   "value": "{{password_admin}}" }
        ]},
        "url": { "raw": "{{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/token",
          "host": ["{{keycloak_url}}"], "path": ["realms","{{realm}}","protocol","openid-connect","token"] }
      }
    },
    {
      "name": "Setup — POST convenio (para relatorio de pacientes)",
      "event": [
        { "listen": "prerequest", "script": { "exec": [
          "// nome e cnpj unicos por execucao — convenio.nome e convenio.cnpj sao ambos unique no banco",
          "const ts = Date.now().toString();",
          "const r = Math.floor(Math.random()*10).toString();",
          "const raw = (ts + r).slice(-14).padStart(14,'0');",
          "const cnpj = raw.slice(0,2)+'.'+raw.slice(2,5)+'.'+raw.slice(5,8)+'/'+raw.slice(8,12)+'-'+raw.slice(12,14);",
          "pm.collectionVariables.set('rel_cnpj', cnpj);",
          "pm.collectionVariables.set('rel_nome', 'ConvRelatorio-'+ts);",
          "pm.collectionVariables.set('data_relatorio', new Date().toISOString().slice(0,10));"
        ]}},
        { "listen": "test", "script": { "exec": [
          "pm.test('Convenio criado 201', () => {",
          "  pm.expect(pm.response.code).to.eql(201);",
          "  pm.collectionVariables.set('convenio_id', pm.response.json().id);",
          "});"
        ]}}
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"nome\": \"{{rel_nome}}\",\n  \"descricao\": \"Setup para relatorio\",\n  \"cnpj\": \"{{rel_cnpj}}\",\n  \"telefone\": \"(34) 90000-9999\",\n  \"ativo\": true\n}" },
        "url": { "raw": "{{admin_base_url}}/v1/convenios", "host": ["{{admin_base_url}}"], "path": ["v1","convenios"] }
      }
    },
    {
      "name": "Relatorio — GET consultas diarias",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "pm.test('Data correta', () => pm.expect(pm.response.json().data).to.eql(pm.collectionVariables.get('data_relatorio')));",
        "pm.test('Total numerico', () => pm.expect(pm.response.json().totalConsultas).to.be.a('number'));"
      ]}}],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": { "raw": "{{admin_base_url}}/v1/relatorios/consultas-diarias?data={{data_relatorio}}", "host": ["{{admin_base_url}}"], "path": ["v1","relatorios","consultas-diarias"], "query": [{ "key": "data", "value": "{{data_relatorio}}" }] }
      }
    },
    {
      "name": "Relatorio — GET consultas diarias 400 data invalida",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
      ]}}],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": { "raw": "{{admin_base_url}}/v1/relatorios/consultas-diarias?data=data-invalida", "host": ["{{admin_base_url}}"], "path": ["v1","relatorios","consultas-diarias"], "query": [{ "key": "data", "value": "data-invalida" }] }
      }
    },
    {
      "name": "Relatorio — GET pacientes por convenio",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "pm.test('Convenio correto', () => pm.expect(pm.response.json().convenioId).to.eql(Number(pm.collectionVariables.get('convenio_id'))));",
        "pm.test('Total numerico', () => pm.expect(pm.response.json().totalPacientes).to.be.a('number'));",
        "pm.test('Pacientes array', () => pm.expect(pm.response.json().pacientes).to.be.an('array'));"
      ]}}],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": { "raw": "{{admin_base_url}}/v1/relatorios/pacientes-por-convenio?convenioId={{convenio_id}}", "host": ["{{admin_base_url}}"], "path": ["v1","relatorios","pacientes-por-convenio"], "query": [{ "key": "convenioId", "value": "{{convenio_id}}" }] }
      }
    },
    {
      "name": "Relatorio — GET pacientes por convenio inexistente",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "pm.test('Total zero', () => pm.expect(pm.response.json().totalPacientes).to.eql(0));",
        "pm.test('Pacientes vazio', () => pm.expect(pm.response.json().pacientes).to.be.an('array').that.is.empty);"
      ]}}],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": { "raw": "{{admin_base_url}}/v1/relatorios/pacientes-por-convenio?convenioId=999999", "host": ["{{admin_base_url}}"], "path": ["v1","relatorios","pacientes-por-convenio"], "query": [{ "key": "convenioId", "value": "999999" }] }
      }
    }
  ]
}
