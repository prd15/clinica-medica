{
  "info": {
    "name": "Clinica Medica — Relatorios",
    "_postman_id": "clinica-relatorios-001",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8081" },
    { "key": "convenio_id", "value": "1" },
    { "key": "data_relatorio", "value": "2026-05-12" }
  ],
  "item": [
    {
      "name": "Relatorio — GET consultas diarias",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Data correta', () => pm.expect(pm.response.json().data).to.eql(pm.collectionVariables.get('data_relatorio')));",
              "pm.test('Total numerico', () => pm.expect(pm.response.json().totalConsultas).to.be.a('number'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/v1/relatorios/consultas-diarias?data={{data_relatorio}}",
          "host": ["{{base_url}}"],
          "path": ["v1", "relatorios", "consultas-diarias"],
          "query": [{ "key": "data", "value": "{{data_relatorio}}" }]
        }
      }
    },
    {
      "name": "Relatorio — GET consultas diarias 400 data invalida",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/v1/relatorios/consultas-diarias?data=data-invalida",
          "host": ["{{base_url}}"],
          "path": ["v1", "relatorios", "consultas-diarias"],
          "query": [{ "key": "data", "value": "data-invalida" }]
        }
      }
    },
    {
      "name": "Relatorio — GET pacientes por convenio",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Convenio correto', () => pm.expect(pm.response.json().convenioId).to.eql(Number(pm.collectionVariables.get('convenio_id'))));",
              "pm.test('Total numerico', () => pm.expect(pm.response.json().totalPacientes).to.be.a('number'));",
              "pm.test('Pacientes array', () => pm.expect(pm.response.json().pacientes).to.be.an('array'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/v1/relatorios/pacientes-por-convenio?convenioId={{convenio_id}}",
          "host": ["{{base_url}}"],
          "path": ["v1", "relatorios", "pacientes-por-convenio"],
          "query": [{ "key": "convenioId", "value": "{{convenio_id}}" }]
        }
      }
    },
    {
      "name": "Relatorio — GET pacientes por convenio inexistente",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Total zero', () => pm.expect(pm.response.json().totalPacientes).to.eql(0));",
              "pm.test('Pacientes vazio', () => pm.expect(pm.response.json().pacientes).to.be.an('array').that.is.empty);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/v1/relatorios/pacientes-por-convenio?convenioId=999999",
          "host": ["{{base_url}}"],
          "path": ["v1", "relatorios", "pacientes-por-convenio"],
          "query": [{ "key": "convenioId", "value": "999999" }]
        }
      }
    }
  ]
}
