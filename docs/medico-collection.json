          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Dr. Outro\",\n  \"crm\": \"CRM-MG-DUPLICADO\",\n  \"senha\": \"senha123\",\n  \"telefone\": \"34988880000\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/v1/medicos",
          "host": ["{{base_url}}"],
          "path": ["v1", "medicos"]
        }
      }
    },
    {
      "name": "Medico — POST 400 nome vazio",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
