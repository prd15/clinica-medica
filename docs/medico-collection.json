{
  "info": {
    "name": "Clinica Medica — Medico",
    "_postman_id": "clinica-medico-001",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "medico_id",       "value": "" },
    { "key": "especialidade_id","value": "" },
    { "key": "medico_crm",      "value": "" }
  ],
  "item": [
    {
      "name": "00 - Obter Token ADMIN",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Token ADMIN obtido', () => pm.response.to.have.status(200));",
        "pm.environment.set('token_admin', pm.response.json().access_token);"
      ]}}],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
        "body": { "mode": "urlencoded", "urlencoded": [
          { "key": "grant_type", "value": "password" },
          { "key": "client_id",  "value": "{{client_id}}" },
          { "key": "username",   "value": "{{username_admin}}" },
          { "key": "password",   "value": "{{password_admin}}" }
        ]},
        "url": { "raw": "{{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/token",
          "host": ["{{keycloak_url}}"], "path": ["realms","{{realm}}","protocol","openid-connect","token"] }
      }
    },
    {
      "name": "Setup — POST especialidade (pre-req)",
      "event": [
        { "listen": "prerequest", "script": { "exec": [
          "pm.collectionVariables.set('setup_esp_nome', 'Cardiologia-Med-'+Date.now());"
        ]}},
        { "listen": "test", "script": { "exec": [
          "pm.test('Especialidade criada 201', () => pm.response.to.have.status(201));",
          "pm.collectionVariables.set('especialidade_id', pm.response.json().id);"
        ]}}
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"nome\": \"{{setup_esp_nome}}\",\n  \"descricao\": \"Para chaining de testes\"\n}" },
        "url": { "raw": "{{admin_base_url}}/v1/especialidades", "host": ["{{admin_base_url}}"], "path": ["v1","especialidades"] }
      }
    },
    {
      "name": "Medico — POST create",
      "event": [
        { "listen": "prerequest", "script": { "exec": [
          "pm.collectionVariables.set('medico_crm', 'CRM-MG-'+Date.now());"
        ]}},
        { "listen": "test", "script": { "exec": [
          "pm.test('Criado 201', () => pm.response.to.have.status(201));",
          "pm.test('Tem ID', () => { const j=pm.response.json(); pm.expect(j.id).to.be.a('number'); pm.collectionVariables.set('medico_id',j.id); });",
          "pm.test('Nome correto', () => pm.expect(pm.response.json().nome).to.eql('Dr. Carlos Silva'));",
          "pm.test('Sem senha no response', () => pm.expect(pm.response.json()).to.not.have.property('senha'));",
          "pm.test('Ativo true', () => pm.expect(pm.response.json().ativo).to.be.true);"
        ]}}
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Dr. Carlos Silva\",\n  \"crm\": \"{{medico_crm}}\",\n  \"senha\": \"senha123\",\n  \"telefone\": \"34988887777\"\n}" },
        "url": { "raw": "{{admin_base_url}}/v1/medicos", "host": ["{{admin_base_url}}"], "path": ["v1","medicos"] }
      }
    },
    {
      "name": "Medico — POST CRM duplicado seed",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 201 ou 409', () => pm.expect([201, 409]).to.include(pm.response.code));"
      ]}}],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Dr. Duplicado Seed\",\n  \"crm\": \"CRM-MG-DUPLICADO\",\n  \"senha\": \"senha123\",\n  \"telefone\": \"34900000000\"\n}" },
        "url": { "raw": "{{admin_base_url}}/v1/medicos", "host": ["{{admin_base_url}}"], "path": ["v1","medicos"] }
      }
    },
    {
      "name": "Medico — POST CRM duplicado 409",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('409 Conflict', () => pm.response.to.have.status(409));"
      ]}}],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Dr. Outro\",\n  \"crm\": \"CRM-MG-DUPLICADO\",\n  \"senha\": \"senha123\",\n  \"telefone\": \"34988880000\"\n}" },
        "url": { "raw": "{{admin_base_url}}/v1/medicos", "host": ["{{admin_base_url}}"], "path": ["v1","medicos"] }
      }
    },
    {
      "name": "Medico — POST 400 nome vazio",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
      ]}}],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "body": { "mode": "raw", "raw": "{\"nome\": \"\", \"crm\": \"\", \"senha\": \"\"}" },
        "url": { "raw": "{{admin_base_url}}/v1/medicos", "host": ["{{admin_base_url}}"], "path": ["v1","medicos"] }
      }
    },
    {
      "name": "Medico — GET list",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "pm.test('Array', () => pm.expect(pm.response.json()).to.be.an('array'));"
      ]}}],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": { "raw": "{{admin_base_url}}/v1/medicos", "host": ["{{admin_base_url}}"], "path": ["v1","medicos"] }
      }
    },
    {
      "name": "Medico — GET ativos true",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "pm.test('Array', () => pm.expect(pm.response.json()).to.be.an('array'));",
        "pm.test('Todos ativos', () => { pm.response.json().forEach(m => pm.expect(m.ativo).to.be.true); });"
      ]}}],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": { "raw": "{{admin_base_url}}/v1/medicos/ativos?ativo=true", "host": ["{{admin_base_url}}"], "path": ["v1","medicos","ativos"], "query": [{ "key": "ativo", "value": "true" }] }
      }
    },
    {
      "name": "Medico — GET ativos default",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "pm.test('Array', () => pm.expect(pm.response.json()).to.be.an('array'));"
      ]}}],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": { "raw": "{{admin_base_url}}/v1/medicos/ativos", "host": ["{{admin_base_url}}"], "path": ["v1","medicos","ativos"] }
      }
    },
    {
      "name": "Medico — GET by ID",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "pm.test('Nome correto', () => pm.expect(pm.response.json().nome).to.eql('Dr. Carlos Silva'));",
        "pm.test('Sem senha', () => pm.expect(pm.response.json()).to.not.have.property('senha'));"
      ]}}],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": { "raw": "{{admin_base_url}}/v1/medicos/{{medico_id}}", "host": ["{{admin_base_url}}"], "path": ["v1","medicos","{{medico_id}}"] }
      }
    },
    {
      "name": "Medico — GET by ID 404",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
      ]}}],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": { "raw": "{{admin_base_url}}/v1/medicos/999999", "host": ["{{admin_base_url}}"], "path": ["v1","medicos","999999"] }
      }
    },
    {
      "name": "Medico — PUT update",
      "event": [
        { "listen": "prerequest", "script": { "exec": [
          "pm.collectionVariables.set('medico_crm_upd', 'CRM-UP-'+Date.now());"
        ]}},
        { "listen": "test", "script": { "exec": [
          "pm.test('200 OK', () => pm.response.to.have.status(200));",
          "pm.test('Nome atualizado', () => pm.expect(pm.response.json().nome).to.eql('Dr. Carlos Eduardo Silva'));"
        ]}}
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Dr. Carlos Eduardo Silva\",\n  \"crm\": \"{{medico_crm_upd}}\",\n  \"senha\": \"novaSenha456\",\n  \"telefone\": \"34988887777\"\n}" },
        "url": { "raw": "{{admin_base_url}}/v1/medicos/{{medico_id}}", "host": ["{{admin_base_url}}"], "path": ["v1","medicos","{{medico_id}}"] }
      }
    },
    {
      "name": "Medico — PUT 404",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
      ]}}],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "body": { "mode": "raw", "raw": "{\"nome\": \"Ghost\", \"crm\": \"CRM-X\", \"senha\": \"senha123\"}" },
        "url": { "raw": "{{admin_base_url}}/v1/medicos/999999", "host": ["{{admin_base_url}}"], "path": ["v1","medicos","999999"] }
      }
    },
    {
      "name": "Medico — POST associar especialidade",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "pm.test('Especialidades nao vazio', () => { pm.expect(pm.response.json().especialidades).to.be.an('array').that.is.not.empty; });"
      ]}}],
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": { "raw": "{{admin_base_url}}/v1/medicos/{{medico_id}}/especialidades/{{especialidade_id}}", "host": ["{{admin_base_url}}"], "path": ["v1","medicos","{{medico_id}}","especialidades","{{especialidade_id}}"] }
      }
    },
    {
      "name": "Medico — POST associar duplicado 409",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('409 Conflict', () => pm.response.to.have.status(409));"
      ]}}],
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": { "raw": "{{admin_base_url}}/v1/medicos/{{medico_id}}/especialidades/{{especialidade_id}}", "host": ["{{admin_base_url}}"], "path": ["v1","medicos","{{medico_id}}","especialidades","{{especialidade_id}}"] }
      }
    },
    {
      "name": "Medico — POST associar medico 404",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
      ]}}],
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": { "raw": "{{admin_base_url}}/v1/medicos/999999/especialidades/{{especialidade_id}}", "host": ["{{admin_base_url}}"], "path": ["v1","medicos","999999","especialidades","{{especialidade_id}}"] }
      }
    },
    {
      "name": "Medico — GET by ID com especialidade",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "pm.test('Tem especialidade', () => { pm.expect(pm.response.json().especialidades).to.be.an('array').that.is.not.empty; });"
      ]}}],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": { "raw": "{{admin_base_url}}/v1/medicos/{{medico_id}}", "host": ["{{admin_base_url}}"], "path": ["v1","medicos","{{medico_id}}"] }
      }
    },
    {
      "name": "Medico — DELETE remover especialidade",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "pm.test('Especialidades vazio', () => { pm.expect(pm.response.json().especialidades).to.be.an('array').that.is.empty; });"
      ]}}],
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": { "raw": "{{admin_base_url}}/v1/medicos/{{medico_id}}/especialidades/{{especialidade_id}}", "host": ["{{admin_base_url}}"], "path": ["v1","medicos","{{medico_id}}","especialidades","{{especialidade_id}}"] }
      }
    },
    {
      "name": "Medico — PATCH inativar",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "pm.test('Ativo false', () => pm.expect(pm.response.json().ativo).to.be.false);"
      ]}}],
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": { "raw": "{{admin_base_url}}/v1/medicos/{{medico_id}}/inativar", "host": ["{{admin_base_url}}"], "path": ["v1","medicos","{{medico_id}}","inativar"] }
      }
    },
    {
      "name": "Medico — PATCH inativar 404",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
      ]}}],
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": { "raw": "{{admin_base_url}}/v1/medicos/999999/inativar", "host": ["{{admin_base_url}}"], "path": ["v1","medicos","999999","inativar"] }
      }
    },
    {
      "name": "Medico — DELETE",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('204 No Content', () => pm.response.to.have.status(204));"
      ]}}],
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": { "raw": "{{admin_base_url}}/v1/medicos/{{medico_id}}", "host": ["{{admin_base_url}}"], "path": ["v1","medicos","{{medico_id}}"] }
      }
    },
    {
      "name": "Medico — DELETE 404",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
      ]}}],
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": { "raw": "{{admin_base_url}}/v1/medicos/999999", "host": ["{{admin_base_url}}"], "path": ["v1","medicos","999999"] }
      }
    },
    {
      "name": "Cleanup — DELETE especialidade",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('204 No Content', () => pm.response.to.have.status(204));"
      ]}}],
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": { "raw": "{{admin_base_url}}/v1/especialidades/{{especialidade_id}}", "host": ["{{admin_base_url}}"], "path": ["v1","especialidades","{{especialidade_id}}"] }
      }
    }
  ]
}
