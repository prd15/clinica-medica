        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Dr. Carlos Eduardo Silva\",\n  \"crm\": \"CRM-MG-ATT\",\n  \"senha\": \"novaSenha456\",\n  \"telefone\": \"34988887777\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/v1/medicos/{{medico_id}}",
          "host": ["{{base_url}}"],
          "path": ["v1", "medicos", "{{medico_id}}"]
