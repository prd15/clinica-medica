{
  "info": {
    "name": "Clinica Medica — Medico",
    "_postman_id": "clinica-medico-001",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8081" },
    { "key": "medico_id", "value": "" },
    { "key": "especialidade_id", "value": "" }
  ],
  "item": [
    {
      "name": "Setup — POST especialidade (pre-req)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Especialidade criada 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('especialidade_id', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Cardiologia Teste Medico\",\n  \"descricao\": \"Para chaining de testes\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/v1/especialidades",
          "host": ["{{base_url}}"],
          "path": ["v1", "especialidades"]
        }
      }
    },
    {
      "name": "Medico — POST create",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Criado 201', () => pm.response.to.have.status(201));",
              "pm.test('Tem ID', () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json.id).to.be.a('number');",
              "  pm.collectionVariables.set('medico_id', json.id);",
              "});",
              "pm.test('Nome correto', () => pm.expect(pm.response.json().nome).to.eql('Dr. Carlos Silva'));",
              "pm.test('Sem senha no response', () => pm.expect(pm.response.json()).to.not.have.property('senha'));",
              "pm.test('Ativo true', () => pm.expect(pm.response.json().ativo).to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Dr. Carlos Silva\",\n  \"crm\": \"CRM-MG-{{$timestamp}}\",\n  \"senha\": \"senha123\",\n  \"telefone\": \"34988887777\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/v1/medicos",
          "host": ["{{base_url}}"],
          "path": ["v1", "medicos"]
        }
      }
    },
    {
      "name": "Medico — POST CRM duplicado seed",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201 ou 409', () => pm.expect([201, 409]).to.include(pm.response.code));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Dr. Duplicado Seed\",\n  \"crm\": \"CRM-MG-DUPLICADO\",\n  \"senha\": \"senha123\",\n  \"telefone\": \"34900000000\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/v1/medicos",
          "host": ["{{base_url}}"],
          "path": ["v1", "medicos"]
        }
      }
    },
    {
      "name": "Medico — POST CRM duplicado 409",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('409 Conflict', () => pm.response.to.have.status(409));"
