  },
  "variable": [
    {
      "key": "admin_url",
      "value": "http://localhost:8081"
    },
    {
      "key": "agenda_url",
      "value": "http://localhost:8082"
    },
    {
      "key": "convenio_ativo_id",
      "value": ""
    },
    {
      "key": "convenio_inativo_id",
      "value": ""
    },
    {
      "key": "medico_id",
      "value": ""
    },
    {
      "key": "paciente_id",
      "value": ""
    },
    {
      "key": "consulta_id",
      "value": ""
    },
    {
      "key": "consulta_dataHora",
      "value": ""
    },
    {
      "key": "consulta_dataHora_2",
      "value": ""
    },
    {
      "key": "consulta_data",
      "value": ""
