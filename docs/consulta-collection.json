  "item": [
    {
      "name": "1. Setup - dependencias no Administrativo",
      "description": "Cria os recursos minimos (convenio ativo, convenio inativo, medico, paciente) no microsservico administrativo para que as consultas possam referencia-los.",
      "item": [
        {
          "name": "Setup - POST Convenio ATIVO",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const d = String(Date.now()).slice(-8).padStart(8, '0');",
                  "const cnpj = d.slice(0,2) + '.' + d.slice(2,5) + '.' + d.slice(5,8) + '/0001-' + d.slice(0,2);",
                  "pm.collectionVariables.set('setup_cnpj_ativo', cnpj);",
                  "// gera dois horarios distintos no futuro para os testes",
                  "const base = new Date();",
                  "base.setDate(base.getDate() + 30);",
                  "base.setHours(10, 0, 0, 0);",
                  "const iso = (dt) => dt.toISOString().slice(0,19);",
                  "pm.collectionVariables.set('consulta_dataHora', iso(base));",
                  "const data2 = new Date(base.getTime());",
                  "data2.setDate(data2.getDate() + 1);",
                  "data2.setHours(14, 0, 0, 0);",
                  "pm.collectionVariables.set('consulta_dataHora_2', iso(data2));",
                  "pm.collectionVariables.set('consulta_data', iso(base).slice(0,10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('convenio_ativo_id', json.id);",
                  "pm.test('Ativo true', () => pm.expect(json.ativo).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Unimed Teste\",\n  \"descricao\": \"Convenio ativo para testes\",\n  \"cnpj\": \"{{setup_cnpj_ativo}}\",\n  \"telefone\": \"(34) 99999-0001\",\n  \"ativo\": true\n}"
            },
            "url": {
              "raw": "{{admin_url}}/v1/convenios",
              "host": [
                "{{admin_url}}"
              ],
              "path": [
                "v1",
                "convenios"
              ]
            }
          }
        },
        {
          "name": "Setup - POST Convenio INATIVO",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const d = String(Date.now() + 1).slice(-8).padStart(8, '0');",
                  "const cnpj = d.slice(0,2) + '.' + d.slice(2,5) + '.' + d.slice(5,8) + '/0002-' + d.slice(0,2);",
                  "pm.collectionVariables.set('setup_cnpj_inativo', cnpj);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('convenio_inativo_id', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Convenio Inativo Teste\",\n  \"descricao\": \"Convenio inativo para testes de erro\",\n  \"cnpj\": \"{{setup_cnpj_inativo}}\",\n  \"telefone\": \"(34) 99999-0002\",\n  \"ativo\": false\n}"
            },
            "url": {
              "raw": "{{admin_url}}/v1/convenios",
              "host": [
                "{{admin_url}}"
              ],
              "path": [
                "v1",
                "convenios"
              ]
            }
          }
        },
