              "raw": "{\n  \"nome\": \"Dr. Carlos Teste\",\n  \"crm\": \"{{setup_crm}}\",\n  \"senha\": \"senha123\",\n  \"telefone\": \"(34) 98888-0000\",\n  \"ativo\": true\n}"
