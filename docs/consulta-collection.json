        {
          "name": "PATCH reagendar com conflito - 400",
          "description": "Cria uma segunda consulta em outro horario e tenta reagendar a primeira para o horario da segunda.",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Cria uma segunda consulta em horario novo via API pra forcar o conflito",
                  "const newDate = new Date();",
                  "newDate.setDate(newDate.getDate() + 60);",
                  "newDate.setHours(9, 0, 0, 0);",
                  "const iso = newDate.toISOString().slice(0,19);",
                  "pm.collectionVariables.set('conflito_dataHora', iso);",
                  "pm.sendRequest({",
                  "  url: pm.collectionVariables.get('agenda_url') + '/v1/consultas',",
                  "  method: 'POST',",
                  "  header: { 'Content-Type': 'application/json' },",
                  "  body: { mode: 'raw', raw: JSON.stringify({",
                  "    pacienteId: Number(pm.collectionVariables.get('paciente_id')),",
                  "    medicoId: Number(pm.collectionVariables.get('medico_id')),",
                  "    convenioId: Number(pm.collectionVariables.get('convenio_ativo_id')),",
                  "    dataHora: iso,",
                  "    observacoes: 'segunda consulta'",
                  "  }) }",
                  "}, (err, res) => {",
                  "  if (!err && res.code === 201) {",
                  "    pm.collectionVariables.set('consulta_id_2', res.json().id);",
                  "  }",
