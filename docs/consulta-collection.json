{
  "info": {
    "name": "Clinica Medica - Consulta (Agendamento)",
    "_postman_id": "clinica-consulta-001",
    "description": "Rode na ordem: Tokens, Setup, Casos de sucesso, Casos de erro.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "convenio_ativo_id",   "value": "" },
    { "key": "convenio_inativo_id", "value": "" },
    { "key": "medico_id",           "value": "" },
    { "key": "paciente_id",         "value": "" },
    { "key": "consulta_id",         "value": "" },
    { "key": "consulta_dataHora",   "value": "" },
    { "key": "consulta_dataHora_2", "value": "" },
    { "key": "consulta_data",       "value": "" }
  ],
  "item": [
    {
      "name": "00 - Obter Tokens",
      "item": [
        {
          "name": "Token ADMIN",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Token ADMIN', () => pm.response.to.have.status(200));",
            "pm.environment.set('token_admin', pm.response.json().access_token);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "grant_type", "value": "password" },
              { "key": "client_id",  "value": "{{client_id}}" },
              { "key": "username",   "value": "{{username_admin}}" },
              { "key": "password",   "value": "{{password_admin}}" }
            ]},
            "url": { "raw": "{{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/token",
              "host": ["{{keycloak_url}}"], "path": ["realms","{{realm}}","protocol","openid-connect","token"] }
          }
        },
        {
          "name": "Token ATENDENTE",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Token ATENDENTE', () => pm.response.to.have.status(200));",
            "pm.environment.set('token_atendente', pm.response.json().access_token);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "grant_type", "value": "password" },
              { "key": "client_id",  "value": "{{client_id}}" },
              { "key": "username",   "value": "{{username_atendente}}" },
              { "key": "password",   "value": "{{password_atendente}}" }
            ]},
            "url": { "raw": "{{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/token",
              "host": ["{{keycloak_url}}"], "path": ["realms","{{realm}}","protocol","openid-connect","token"] }
          }
        },
        {
          "name": "Token MEDICO",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Token MEDICO', () => pm.response.to.have.status(200));",
            "pm.environment.set('token_medico', pm.response.json().access_token);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "grant_type", "value": "password" },
              { "key": "client_id",  "value": "{{client_id}}" },
              { "key": "username",   "value": "{{username_medico}}" },
              { "key": "password",   "value": "{{password_medico}}" }
            ]},
            "url": { "raw": "{{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/token",
              "host": ["{{keycloak_url}}"], "path": ["realms","{{realm}}","protocol","openid-connect","token"] }
          }
        }
      ]
    },
    {
      "name": "1. Setup - dependencias no Administrativo",
      "item": [
        {
          "name": "Setup - POST Convenio ATIVO (ADMIN)",
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "pm.collectionVariables.set('setup_conv_ativo_nome', 'UnimedTeste-'+Date.now());",
              "const d = String(Date.now()).slice(-8).padStart(8,'0');",
              "const cnpj = d.slice(0,2)+'.'+d.slice(2,5)+'.'+d.slice(5,8)+'/0001-'+d.slice(0,2);",
              "pm.collectionVariables.set('setup_cnpj_ativo', cnpj);",
              "const base = new Date(); base.setDate(base.getDate()+30); base.setHours(10,0,0,0);",
              "const iso = dt => dt.toISOString().slice(0,19);",
              "pm.collectionVariables.set('consulta_dataHora', iso(base));",
              "const d2 = new Date(base.getTime()); d2.setDate(d2.getDate()+1); d2.setHours(14,0,0,0);",
              "pm.collectionVariables.set('consulta_dataHora_2', iso(d2));",
              "pm.collectionVariables.set('consulta_data', iso(base).slice(0,10));"
            ]}},
            { "listen": "test", "script": { "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('convenio_ativo_id', pm.response.json().id);",
              "pm.test('Ativo true', () => pm.expect(pm.response.json().ativo).to.eql(true));"
            ]}}
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"{{setup_conv_ativo_nome}}\",\n  \"descricao\": \"Convenio ativo para testes\",\n  \"cnpj\": \"{{setup_cnpj_ativo}}\",\n  \"telefone\": \"(34) 99999-0001\",\n  \"ativo\": true\n}" },
            "url": { "raw": "{{admin_base_url}}/v1/convenios", "host": ["{{admin_base_url}}"], "path": ["v1","convenios"] }
          }
        },
        {
          "name": "Setup - POST Convenio INATIVO (ADMIN)",
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "pm.collectionVariables.set('setup_conv_inativo_nome', 'ConvenioInativoTeste-'+Date.now());",
              "const d = String(Date.now()+1).slice(-8).padStart(8,'0');",
              "pm.collectionVariables.set('setup_cnpj_inativo', d.slice(0,2)+'.'+d.slice(2,5)+'.'+d.slice(5,8)+'/0002-'+d.slice(0,2));"
            ]}},
            { "listen": "test", "script": { "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('convenio_inativo_id', pm.response.json().id);"
            ]}}
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"{{setup_conv_inativo_nome}}\",\n  \"descricao\": \"Convenio inativo para testes de erro\",\n  \"cnpj\": \"{{setup_cnpj_inativo}}\",\n  \"telefone\": \"(34) 99999-0002\",\n  \"ativo\": false\n}" },
            "url": { "raw": "{{admin_base_url}}/v1/convenios", "host": ["{{admin_base_url}}"], "path": ["v1","convenios"] }
          }
        },
        {
          "name": "Setup - POST Medico (ADMIN)",
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "pm.collectionVariables.set('setup_crm', 'CRM-'+Date.now().toString().slice(-6));"
            ]}},
            { "listen": "test", "script": { "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('medico_id', pm.response.json().id);"
            ]}}
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Dr. Carlos Teste\",\n  \"crm\": \"{{setup_crm}}\",\n  \"senha\": \"senha123\",\n  \"telefone\": \"(34) 98888-0000\",\n  \"ativo\": true\n}" },
            "url": { "raw": "{{admin_base_url}}/v1/medicos", "host": ["{{admin_base_url}}"], "path": ["v1","medicos"] }
          }
        },
        {
          "name": "Setup - POST Paciente (ADMIN)",
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "const d = String(Date.now()).slice(-11).padStart(11,'0');",
              "pm.collectionVariables.set('setup_cpf', d);"
            ]}},
            { "listen": "test", "script": { "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('paciente_id', pm.response.json().id);"
            ]}}
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Paciente Teste\",\n  \"cpf\": \"{{setup_cpf}}\",\n  \"telefone\": \"(34) 97777-0000\",\n  \"email\": \"paciente@teste.com\",\n  \"endereco\": \"Rua Teste, 123\",\n  \"convenioId\": {{convenio_ativo_id}}\n}" },
            "url": { "raw": "{{admin_base_url}}/v1/pacientes", "host": ["{{admin_base_url}}"], "path": ["v1","pacientes"] }
          }
        }
      ]
    },
    {
      "name": "2. Casos de sucesso",
      "item": [
        {
          "name": "POST agendar - 201 (ATENDENTE)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "const j=pm.response.json();",
            "pm.test('Tem id', () => pm.expect(j.id).to.be.a('number'));",
            "pm.test('Status PENDENTE', () => pm.expect(j.status).to.eql('PENDENTE'));",
            "pm.collectionVariables.set('consulta_id', j.id);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_atendente}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"pacienteId\": {{paciente_id}},\n  \"medicoId\": {{medico_id}},\n  \"convenioId\": {{convenio_ativo_id}},\n  \"dataHora\": \"{{consulta_dataHora}}\",\n  \"observacoes\": \"Consulta de rotina\"\n}" },
            "url": { "raw": "{{agenda_base_url}}/v1/consultas", "host": ["{{agenda_base_url}}"], "path": ["v1","consultas"] }
          }
        },
        {
          "name": "GET listar por medicoId (ATENDENTE)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const arr=pm.response.json();",
            "pm.test('Array', () => pm.expect(arr).to.be.an('array'));",
            "pm.test('Contem a consulta criada', () => { const id=Number(pm.collectionVariables.get('consulta_id')); pm.expect(arr.some(c=>c.id===id)).to.be.true; });"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_atendente}}" }],
            "url": { "raw": "{{agenda_base_url}}/v1/consultas?medicoId={{medico_id}}", "host": ["{{agenda_base_url}}"], "path": ["v1","consultas"], "query": [{ "key": "medicoId", "value": "{{medico_id}}" }] }
          }
        },
        {
          "name": "GET minha-agenda (MEDICO) - escopo do proprio token",
          "event": [{ "listen": "test", "script": { "exec": [
            "// MEDICO usa o medicoId do proprio JWT; o param e ignorado/forcado ao dono",
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Array', () => pm.expect(pm.response.json()).to.be.an('array'));"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_medico}}" }],
            "url": { "raw": "{{agenda_base_url}}/v1/consultas/minha-agenda", "host": ["{{agenda_base_url}}"], "path": ["v1","consultas","minha-agenda"] }
          }
        },
        {
          "name": "GET minha-agenda de outro medico (MEDICO) - 403",
          "event": [{ "listen": "test", "script": { "exec": [
            "// ownership: MEDICO nao pode ver agenda de outro medico via ?medicoId=",
            "pm.test('Status 403', () => pm.response.to.have.status(403));"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_medico}}" }],
            "url": { "raw": "{{agenda_base_url}}/v1/consultas/minha-agenda?medicoId={{medico_id}}", "host": ["{{agenda_base_url}}"], "path": ["v1","consultas","minha-agenda"], "query": [{ "key": "medicoId", "value": "{{medico_id}}" }] }
          }
        },
        {
          "name": "PATCH confirmar - 200 (ATENDENTE)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Status CONFIRMADA', () => pm.expect(pm.response.json().status).to.eql('CONFIRMADA'));"
          ]}}],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_atendente}}" }],
            "url": { "raw": "{{agenda_base_url}}/v1/consultas/{{consulta_id}}/confirmar", "host": ["{{agenda_base_url}}"], "path": ["v1","consultas","{{consulta_id}}","confirmar"] }
          }
        },
        {
          "name": "PATCH reagendar - 200 (ATENDENTE)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('DataHora atualizada', () => { pm.expect(pm.response.json().dataHora.startsWith(pm.collectionVariables.get('consulta_dataHora_2'))).to.be.true; });"
          ]}}],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_atendente}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"dataHora\": \"{{consulta_dataHora_2}}\"}" },
            "url": { "raw": "{{agenda_base_url}}/v1/consultas/{{consulta_id}}/reagendar", "host": ["{{agenda_base_url}}"], "path": ["v1","consultas","{{consulta_id}}","reagendar"] }
          }
        },
        {
          "name": "DELETE cancelar - 200 (ATENDENTE)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Status CANCELADA', () => pm.expect(pm.response.json().status).to.eql('CANCELADA'));"
          ]}}],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_atendente}}" }],
            "url": { "raw": "{{agenda_base_url}}/v1/consultas/{{consulta_id}}", "host": ["{{agenda_base_url}}"], "path": ["v1","consultas","{{consulta_id}}"] }
          }
        },
        {
          "name": "POST agendar - libera slot apos cancelar (ATENDENTE)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "pm.test('Status PENDENTE', () => pm.expect(pm.response.json().status).to.eql('PENDENTE'));",
            "pm.collectionVariables.set('consulta_id', pm.response.json().id);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_atendente}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"pacienteId\": {{paciente_id}},\n  \"medicoId\": {{medico_id}},\n  \"convenioId\": {{convenio_ativo_id}},\n  \"dataHora\": \"{{consulta_dataHora_2}}\",\n  \"observacoes\": \"Reaproveita slot apos CANCELADA\"\n}" },
            "url": { "raw": "{{agenda_base_url}}/v1/consultas", "host": ["{{agenda_base_url}}"], "path": ["v1","consultas"] }
          }
        }
      ]
    },
    {
      "name": "3. Casos de erro",
      "item": [
        {
          "name": "POST conflito de horario - 409 (ATENDENTE)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 409', () => pm.response.to.have.status(409));",
            "pm.test('Mensagem fala sobre horario', () => { pm.expect(pm.response.text().toLowerCase()).to.include('horario'); });"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_atendente}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"pacienteId\": {{paciente_id}},\n  \"medicoId\": {{medico_id}},\n  \"convenioId\": {{convenio_ativo_id}},\n  \"dataHora\": \"{{consulta_dataHora_2}}\",\n  \"observacoes\": \"Tentativa de conflito\"\n}" },
            "url": { "raw": "{{agenda_base_url}}/v1/consultas", "host": ["{{agenda_base_url}}"], "path": ["v1","consultas"] }
          }
        },
        {
          "name": "POST convenio inexistente - 409 (ATENDENTE)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 409', () => pm.response.to.have.status(409));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_atendente}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"pacienteId\": {{paciente_id}},\n  \"medicoId\": {{medico_id}},\n  \"convenioId\": 999999,\n  \"dataHora\": \"{{consulta_dataHora}}\",\n  \"observacoes\": \"convenio nao existe\"\n}" },
            "url": { "raw": "{{agenda_base_url}}/v1/consultas", "host": ["{{agenda_base_url}}"], "path": ["v1","consultas"] }
          }
        },
        {
          "name": "POST convenio inativo - 409 (ATENDENTE)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 409', () => pm.response.to.have.status(409));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_atendente}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"pacienteId\": {{paciente_id}},\n  \"medicoId\": {{medico_id}},\n  \"convenioId\": {{convenio_inativo_id}},\n  \"dataHora\": \"{{consulta_dataHora}}\",\n  \"observacoes\": \"convenio inativo\"\n}" },
            "url": { "raw": "{{agenda_base_url}}/v1/consultas", "host": ["{{agenda_base_url}}"], "path": ["v1","consultas"] }
          }
        },
        {
          "name": "POST body invalido (campos faltando) - 400 (ATENDENTE)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 400', () => pm.response.to.have.status(400));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_atendente}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"observacoes\": \"falta tudo\"}" },
            "url": { "raw": "{{agenda_base_url}}/v1/consultas", "host": ["{{agenda_base_url}}"], "path": ["v1","consultas"] }
          }
        },
        {
          "name": "PATCH reagendar consulta inexistente - 404 (ATENDENTE)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 404', () => pm.response.to.have.status(404));"
          ]}}],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_atendente}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"dataHora\": \"{{consulta_dataHora}}\"}" },
            "url": { "raw": "{{agenda_base_url}}/v1/consultas/999999/reagendar", "host": ["{{agenda_base_url}}"], "path": ["v1","consultas","999999","reagendar"] }
          }
        },
        {
          "name": "POST agendar com data no passado - 400 (ATENDENTE)",
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "const p = new Date(); p.setDate(p.getDate()-1); p.setHours(10,0,0,0);",
              "pm.collectionVariables.set('dataHora_passado', p.toISOString().slice(0,19));"
            ]}},
            { "listen": "test", "script": { "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));",
              "pm.test('Mensagem fala sobre passado', () => { pm.expect(pm.response.text().toLowerCase()).to.include('passado'); });"
            ]}}
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_atendente}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"pacienteId\": {{paciente_id}},\n  \"medicoId\": {{medico_id}},\n  \"convenioId\": {{convenio_ativo_id}},\n  \"dataHora\": \"{{dataHora_passado}}\",\n  \"observacoes\": \"nao deve aceitar\"\n}" },
            "url": { "raw": "{{agenda_base_url}}/v1/consultas", "host": ["{{agenda_base_url}}"], "path": ["v1","consultas"] }
          }
        },
        {
          "name": "PATCH confirmar consulta inexistente - 404 (ATENDENTE)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 404', () => pm.response.to.have.status(404));"
          ]}}],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_atendente}}" }],
            "url": { "raw": "{{agenda_base_url}}/v1/consultas/999999/confirmar", "host": ["{{agenda_base_url}}"], "path": ["v1","consultas","999999","confirmar"] }
          }
        },
        {
          "name": "DELETE cancelar inexistente - 404 (ATENDENTE)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 404', () => pm.response.to.have.status(404));"
          ]}}],
          "request": {
