{
  "info": {
    "name": "Clinica Medica — Paciente",
    "_postman_id": "clinica-paciente-001",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "convenio_id",  "value": "" },
    { "key": "paciente_id",  "value": "" },
    { "key": "paciente_cpf", "value": "" }
  ],
  "item": [
    {
      "name": "00 - Obter Token ADMIN",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Token ADMIN', () => pm.response.to.have.status(200));",
        "pm.environment.set('token_admin', pm.response.json().access_token);"
      ]}}],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
        "body": { "mode": "urlencoded", "urlencoded": [
          { "key": "grant_type", "value": "password" },
          { "key": "client_id",  "value": "{{client_id}}" },
          { "key": "username",   "value": "{{username_admin}}" },
          { "key": "password",   "value": "{{password_admin}}" }
        ]},
        "url": { "raw": "{{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/token",
          "host": ["{{keycloak_url}}"], "path": ["realms","{{realm}}","protocol","openid-connect","token"] }
      }
    },
    {
      "name": "00 - Obter Token ATENDENTE",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Token ATENDENTE', () => pm.response.to.have.status(200));",
        "pm.environment.set('token_atendente', pm.response.json().access_token);"
      ]}}],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
        "body": { "mode": "urlencoded", "urlencoded": [
          { "key": "grant_type", "value": "password" },
          { "key": "client_id",  "value": "{{client_id}}" },
          { "key": "username",   "value": "{{username_atendente}}" },
          { "key": "password",   "value": "{{password_atendente}}" }
        ]},
        "url": { "raw": "{{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/token",
          "host": ["{{keycloak_url}}"], "path": ["realms","{{realm}}","protocol","openid-connect","token"] }
      }
    },
    {
      "name": "Setup — POST convenio (ADMIN)",
      "event": [
        { "listen": "prerequest", "script": { "exec": [
          "const d = String(Date.now()).slice(-8).padStart(8,'0');",
          "pm.collectionVariables.set('setup_convenio_cnpj', d.slice(0,2)+'.'+d.slice(2,5)+'.'+d.slice(5,8)+'/0001-'+d.slice(0,2));"
        ]}},
        { "listen": "test", "script": { "exec": [
          "pm.test('Convenio criado 201', () => pm.response.to.have.status(201));",
          "pm.collectionVariables.set('convenio_id', pm.response.json().id);"
        ]}}
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Convenio Teste Paciente\",\n  \"descricao\": \"Convenio para testes da collection paciente\",\n  \"cnpj\": \"{{setup_convenio_cnpj}}\",\n  \"telefone\": \"(34) 99000-0000\",\n  \"ativo\": true\n}" },
        "url": { "raw": "{{admin_base_url}}/v1/convenios", "host": ["{{admin_base_url}}"], "path": ["v1","convenios"] }
      }
    },
    {
      "name": "Paciente — POST create (ATENDENTE)",
      "event": [
        { "listen": "prerequest", "script": { "exec": [
          "if (!pm.collectionVariables.get('convenio_id')) throw new Error('Rode Setup convenio antes');",
          "const cpf = String(Date.now()).slice(-11).padStart(11,'0');",
          "pm.collectionVariables.set('paciente_cpf', cpf.slice(0,3)+'.'+cpf.slice(3,6)+'.'+cpf.slice(6,9)+'-'+cpf.slice(9,11));"
        ]}},
        { "listen": "test", "script": { "exec": [
          "pm.test('Criado 201', () => pm.response.to.have.status(201));",
          "pm.test('Tem ID', () => { const j=pm.response.json(); pm.expect(j.id).to.be.a('number'); pm.collectionVariables.set('paciente_id',j.id); });",
          "pm.test('Nome correto', () => pm.expect(pm.response.json().nome).to.eql('Joao da Silva'));",
          "pm.test('CPF presente', () => pm.expect(pm.response.json().cpf).to.eql(pm.collectionVariables.get('paciente_cpf')));"
        ]}}
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_atendente}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Joao da Silva\",\n  \"cpf\": \"{{paciente_cpf}}\",\n  \"dataNascimento\": \"1990-05-15\",\n  \"telefone\": \"(34) 99999-8888\",\n  \"email\": \"joao@email.com\",\n  \"endereco\": \"Rua das Flores, 123\",\n  \"convenioId\": {{convenio_id}}\n}" },
        "url": { "raw": "{{admin_base_url}}/v1/pacientes", "host": ["{{admin_base_url}}"], "path": ["v1","pacientes"] }
      }
    },
    {
      "name": "Paciente — POST 400 nome vazio (ATENDENTE)",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
      ]}}],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_atendente}}" }
        ],
        "body": { "mode": "raw", "raw": "{\"nome\": \"\", \"cpf\": \"\"}" },
        "url": { "raw": "{{admin_base_url}}/v1/pacientes", "host": ["{{admin_base_url}}"], "path": ["v1","pacientes"] }
      }
    },
    {
      "name": "Paciente — GET list (ATENDENTE)",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "pm.test('Array', () => pm.expect(pm.response.json()).to.be.an('array'));",
        "pm.test('Nao vazio', () => pm.expect(pm.response.json().length).to.be.above(0));"
      ]}}],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_atendente}}" }],
        "url": { "raw": "{{admin_base_url}}/v1/pacientes", "host": ["{{admin_base_url}}"], "path": ["v1","pacientes"] }
      }
    },
    {
      "name": "Paciente — GET filter nome (ATENDENTE)",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "pm.test('Array', () => pm.expect(pm.response.json()).to.be.an('array'));"
      ]}}],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_atendente}}" }],
        "url": { "raw": "{{admin_base_url}}/v1/pacientes?nome=Joao", "host": ["{{admin_base_url}}"], "path": ["v1","pacientes"], "query": [{ "key": "nome", "value": "Joao" }] }
      }
    },
    {
      "name": "Paciente — GET filter cpf (ATENDENTE)",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "pm.test('Resultado bate CPF', () => { const arr=pm.response.json(); if(arr.length>0) pm.expect(arr[0].cpf).to.eql(pm.collectionVariables.get('paciente_cpf')); });"
      ]}}],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_atendente}}" }],
        "url": { "raw": "{{admin_base_url}}/v1/pacientes?cpf={{paciente_cpf}}", "host": ["{{admin_base_url}}"], "path": ["v1","pacientes"], "query": [{ "key": "cpf", "value": "{{paciente_cpf}}" }] }
      }
    },
    {
      "name": "Paciente — GET filter convenioId (ATENDENTE)",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "pm.test('Array', () => pm.expect(pm.response.json()).to.be.an('array'));"
      ]}}],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_atendente}}" }],
        "url": { "raw": "{{admin_base_url}}/v1/pacientes?convenioId={{convenio_id}}", "host": ["{{admin_base_url}}"], "path": ["v1","pacientes"], "query": [{ "key": "convenioId", "value": "{{convenio_id}}" }] }
      }
    },
    {
      "name": "Paciente — GET by id (ATENDENTE)",
      "event": [
        { "listen": "prerequest", "script": { "exec": [
          "if (!pm.collectionVariables.get('paciente_id')) throw new Error('Rode POST create antes');"
        ]}},
        { "listen": "test", "script": { "exec": [
          "pm.test('200 OK', () => pm.response.to.have.status(200));",
          "pm.test('ID confere', () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('paciente_id'))));"
        ]}}
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_atendente}}" }],
        "url": { "raw": "{{admin_base_url}}/v1/pacientes/{{paciente_id}}", "host": ["{{admin_base_url}}"], "path": ["v1","pacientes","{{paciente_id}}"] }
      }
    },
    {
      "name": "Paciente — GET by id 404 (ATENDENTE)",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
      ]}}],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_atendente}}" }],
        "url": { "raw": "{{admin_base_url}}/v1/pacientes/999999", "host": ["{{admin_base_url}}"], "path": ["v1","pacientes","999999"] }
      }
    },
    {
      "name": "Paciente — PUT update (ATENDENTE)",
      "event": [
        { "listen": "prerequest", "script": { "exec": [
          "if (!pm.collectionVariables.get('paciente_id') || !pm.collectionVariables.get('convenio_id')) throw new Error('Rode setup + POST create antes');"
        ]}},
        { "listen": "test", "script": { "exec": [
          "pm.test('200 OK', () => pm.response.to.have.status(200));",
          "pm.test('Nome atualizado', () => pm.expect(pm.response.json().nome).to.eql('Joao da Silva Santos'));"
        ]}}
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_atendente}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Joao da Silva Santos\",\n  \"cpf\": \"{{paciente_cpf}}\",\n  \"dataNascimento\": \"1990-05-15\",\n  \"telefone\": \"(34) 97777-6666\",\n  \"email\": \"joao.santos@email.com\",\n  \"endereco\": \"Avenida Brasil, 456\",\n  \"convenioId\": {{convenio_id}}\n}" },
        "url": { "raw": "{{admin_base_url}}/v1/pacientes/{{paciente_id}}", "host": ["{{admin_base_url}}"], "path": ["v1","pacientes","{{paciente_id}}"] }
      }
    },
    {
      "name": "Paciente — PUT 404 (ATENDENTE)",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
      ]}}],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_atendente}}" }
        ],
        "body": { "mode": "raw", "raw": "{\"nome\": \"Ghost\", \"cpf\": \"000.000.000-00\"}" },
        "url": { "raw": "{{admin_base_url}}/v1/pacientes/999999", "host": ["{{admin_base_url}}"], "path": ["v1","pacientes","999999"] }
      }
    },
    {
      "name": "Paciente — DELETE (ADMIN)",
      "event": [
        { "listen": "prerequest", "script": { "exec": [
          "if (!pm.collectionVariables.get('paciente_id')) throw new Error('Rode POST create antes');"
        ]}},
        { "listen": "test", "script": { "exec": [
          "pm.test('204 No Content', () => pm.response.to.have.status(204));"
        ]}}
      ],
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": { "raw": "{{admin_base_url}}/v1/pacientes/{{paciente_id}}", "host": ["{{admin_base_url}}"], "path": ["v1","pacientes","{{paciente_id}}"] }
      }
    },
    {
      "name": "Paciente — DELETE 404 (ADMIN)",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
      ]}}],
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": { "raw": "{{admin_base_url}}/v1/pacientes/999999", "host": ["{{admin_base_url}}"], "path": ["v1","pacientes","999999"] }
      }
    },
    {
      "name": "Cleanup — DELETE convenio (ADMIN)",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('204 No Content', () => pm.response.to.have.status(204));"
      ]}}],
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": { "raw": "{{admin_base_url}}/v1/convenios/{{convenio_id}}", "host": ["{{admin_base_url}}"], "path": ["v1","convenios","{{convenio_id}}"] }
      }
    }
  ]
}
