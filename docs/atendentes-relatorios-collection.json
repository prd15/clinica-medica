{
  "info": {
    "name": "Clinica Medica - Atendentes e Relatorios",
    "_postman_id": "clinica-atendentes-relatorios-001",
    "description": "Collection das rotas implementadas pela Pessoa 3 no microsservico administrativo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8081" },
    { "key": "atendente_id", "value": "" },
    { "key": "convenio_id", "value": "1" },
    { "key": "data_relatorio", "value": "2026-05-12" }
  ],
  "item": [
    {
      "name": "Atendentes",
      "item": [
        {
          "name": "Atendente - POST criar",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Criado 201', () => pm.response.to.have.status(201));",
                  "pm.test('Tem ID', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.id).to.be.a('number');",
                  "  pm.collectionVariables.set('atendente_id', json.id);",
                  "});",
                  "pm.test('Nao retorna senha', () => pm.expect(pm.response.json()).to.not.have.property('senha'));",
                  "pm.test('Ativo true', () => pm.expect(pm.response.json().ativo).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Maria Recepcao\",\n  \"usuario\": \"maria.recepcao.{{$timestamp}}\",\n  \"senha\": \"senha123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/atendentes",
              "host": ["{{base_url}}"],
              "path": ["v1", "atendentes"]
            }
          }
        },
        {
          "name": "Atendente - GET listar",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Lista 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response e array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/v1/atendentes",
              "host": ["{{base_url}}"],
              "path": ["v1", "atendentes"]
            }
          }
        },
        {
          "name": "Atendente - PUT atualizar",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Atualizado 200', () => pm.response.to.have.status(200));",
                  "pm.test('Nome atualizado', () => pm.expect(pm.response.json().nome).to.eql('Maria Recepcao Atualizada'));",
                  "pm.test('Nao retorna senha', () => pm.expect(pm.response.json()).to.not.have.property('senha'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Maria Recepcao Atualizada\",\n  \"usuario\": \"maria.recepcao.atualizada.{{$timestamp}}\",\n  \"senha\": \"novaSenha456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/atendentes/{{atendente_id}}",
              "host": ["{{base_url}}"],
              "path": ["v1", "atendentes", "{{atendente_id}}"]
            }
          }
        },
        {
          "name": "Atendente - DELETE remover",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Removido 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/v1/atendentes/{{atendente_id}}",
              "host": ["{{base_url}}"],
              "path": ["v1", "atendentes", "{{atendente_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Relatorios",
      "item": [
        {
          "name": "Relatorio - GET consultas diarias",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Relatorio 200', () => pm.response.to.have.status(200));",
                  "pm.test('Data correta', () => pm.expect(pm.response.json().data).to.eql(pm.collectionVariables.get('data_relatorio')));",
                  "pm.test('Total e numerico', () => pm.expect(pm.response.json().totalConsultas).to.be.a('number'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/v1/relatorios/consultas-diarias?data={{data_relatorio}}",
              "host": ["{{base_url}}"],
              "path": ["v1", "relatorios", "consultas-diarias"],
              "query": [
                { "key": "data", "value": "{{data_relatorio}}" }
              ]
            }
          }
        },
        {
          "name": "Relatorio - GET pacientes por convenio",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Relatorio 200', () => pm.response.to.have.status(200));",
                  "pm.test('Convenio correto', () => pm.expect(pm.response.json().convenioId).to.eql(Number(pm.collectionVariables.get('convenio_id'))));",
                  "pm.test('Total e numerico', () => pm.expect(pm.response.json().totalPacientes).to.be.a('number'));",
                  "pm.test('Pacientes e array', () => pm.expect(pm.response.json().pacientes).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/v1/relatorios/pacientes-por-convenio?convenioId={{convenio_id}}",
              "host": ["{{base_url}}"],
              "path": ["v1", "relatorios", "pacientes-por-convenio"],
              "query": [
                { "key": "convenioId", "value": "{{convenio_id}}" }
              ]
            }
          }
        }
      ]
    }
  ]
}
