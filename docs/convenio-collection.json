        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.collectionVariables.set('convenio_nome_upd', 'UnimedPremium-' + Date.now());"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
