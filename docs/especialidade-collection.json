{
  "info": {
    "name": "Clinica Medica — Especialidade",
    "_postman_id": "clinica-especialidade-001",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "especialidade_id", "value": "" },
    { "key": "esp_nome",        "value": "" }
  ],
  "item": [
    {
      "name": "00 - Obter Token ADMIN",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Token ADMIN obtido', () => pm.response.to.have.status(200));",
        "pm.environment.set('token_admin', pm.response.json().access_token);"
      ]}}],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
        "body": { "mode": "urlencoded", "urlencoded": [
          { "key": "grant_type", "value": "password" },
          { "key": "client_id",  "value": "{{client_id}}" },
          { "key": "username",   "value": "{{username_admin}}" },
          { "key": "password",   "value": "{{password_admin}}" }
        ]},
        "url": { "raw": "{{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/token",
          "host": ["{{keycloak_url}}"], "path": ["realms","{{realm}}","protocol","openid-connect","token"] }
      }
    },
    {
      "name": "Especialidade — POST create",
      "event": [
        { "listen": "prerequest", "script": { "exec": [
          "pm.collectionVariables.set('esp_nome', 'Cardiologia-'+Date.now());"
        ]}},
        { "listen": "test", "script": { "exec": [
          "pm.test('Criado 201', () => pm.response.to.have.status(201));",
          "pm.test('Tem ID', () => { const j=pm.response.json(); pm.expect(j.id).to.be.a('number'); pm.collectionVariables.set('especialidade_id',j.id); });",
          "pm.test('Nome correto', () => pm.expect(pm.response.json().nome).to.eql(pm.collectionVariables.get('esp_nome')));"
        ]}}
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"nome\": \"{{esp_nome}}\",\n  \"descricao\": \"Especialidade do coracao e sistema cardiovascular\"\n}" },
        "url": { "raw": "{{admin_base_url}}/v1/especialidades", "host": ["{{admin_base_url}}"], "path": ["v1","especialidades"] }
      }
    },
    {
      "name": "Especialidade — POST 400 nome vazio",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
      ]}}],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "body": { "mode": "raw", "raw": "{\"nome\": \"\", \"descricao\": \"sem nome\"}" },
        "url": { "raw": "{{admin_base_url}}/v1/especialidades", "host": ["{{admin_base_url}}"], "path": ["v1","especialidades"] }
      }
    },
    {
      "name": "Especialidade — GET list",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "pm.test('Array', () => pm.expect(pm.response.json()).to.be.an('array'));",
        "pm.test('Nao vazio', () => pm.expect(pm.response.json().length).to.be.above(0));"
      ]}}],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": { "raw": "{{admin_base_url}}/v1/especialidades", "host": ["{{admin_base_url}}"], "path": ["v1","especialidades"] }
      }
    },
    {
      "name": "Especialidade — GET by ID",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "pm.test('Nome correto', () => pm.expect(pm.response.json().nome).to.eql(pm.collectionVariables.get('esp_nome')));"
      ]}}],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": { "raw": "{{admin_base_url}}/v1/especialidades/{{especialidade_id}}", "host": ["{{admin_base_url}}"], "path": ["v1","especialidades","{{especialidade_id}}"] }
      }
    },
    {
      "name": "Especialidade — GET by ID 404",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
      ]}}],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": { "raw": "{{admin_base_url}}/v1/especialidades/999999", "host": ["{{admin_base_url}}"], "path": ["v1","especialidades","999999"] }
      }
    },
    {
      "name": "Especialidade — PUT update",
      "event": [
        { "listen": "prerequest", "script": { "exec": [
          "pm.collectionVariables.set('esp_nome_upd', 'CardioPed-'+Date.now());"
        ]}},
        { "listen": "test", "script": { "exec": [
          "pm.test('200 OK', () => pm.response.to.have.status(200));",
          "pm.test('Nome atualizado', () => pm.expect(pm.response.json().nome).to.eql(pm.collectionVariables.get('esp_nome_upd')));"
        ]}}
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"nome\": \"{{esp_nome_upd}}\",\n  \"descricao\": \"Cardiologia voltada para criancas\"\n}" },
        "url": { "raw": "{{admin_base_url}}/v1/especialidades/{{especialidade_id}}", "host": ["{{admin_base_url}}"], "path": ["v1","especialidades","{{especialidade_id}}"] }
      }
    },
    {
      "name": "Especialidade — PUT 404",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
      ]}}],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "body": { "mode": "raw", "raw": "{\"nome\": \"Ghost\", \"descricao\": \"x\"}" },
        "url": { "raw": "{{admin_base_url}}/v1/especialidades/999999", "host": ["{{admin_base_url}}"], "path": ["v1","especialidades","999999"] }
      }
    },
    {
      "name": "Especialidade — DELETE",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('204 No Content', () => pm.response.to.have.status(204));"
      ]}}],
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": { "raw": "{{admin_base_url}}/v1/especialidades/{{especialidade_id}}", "host": ["{{admin_base_url}}"], "path": ["v1","especialidades","{{especialidade_id}}"] }
      }
    },
    {
      "name": "Especialidade — DELETE 404",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
      ]}}],
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": { "raw": "{{admin_base_url}}/v1/especialidades/999999", "host": ["{{admin_base_url}}"], "path": ["v1","especialidades","999999"] }
      }
    }
  ]
}
