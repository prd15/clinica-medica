            "url": { "raw": "{{base_url}}/v1/medicos/{{medico_id}}/inativar", "host": ["{{base_url}}"], "path": ["v1", "medicos", "{{medico_id}}", "inativar"] }
          }
        },
        {
          "name": "Medico — DELETE remover especialidade",
          "event": [
            {
              "listen": "test",
