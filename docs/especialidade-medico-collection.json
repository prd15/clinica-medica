                  "  const esp = pm.response.json().especialidades;",
                  "  pm.expect(esp).to.be.an('array').that.is.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/v1/medicos/{{medico_id}}/especialidades/{{especialidade_id}}", "host": ["{{base_url}}"], "path": ["v1", "medicos", "{{medico_id}}", "especialidades", "{{especialidade_id}}"] }
          }
        },
        {
