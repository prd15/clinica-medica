                "exec": [
                  "pm.test('Removido 200', () => pm.response.to.have.status(200));",
                  "pm.test('Especialidades vazio', () => {",
                  "  const esp = pm.response.json().especialidades;",
                  "  pm.expect(esp).to.be.an('array').that.is.empty;",
                  "});"
                ]
              }
            }
