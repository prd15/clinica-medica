{
  "realm": "clinica",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "roles": {
    "realm": [
      { "name": "ADMIN",     "composite": false, "clientRole": false },
      { "name": "ATENDENTE", "composite": false, "clientRole": false },
      { "name": "MEDICO",    "composite": false, "clientRole": false },
      { "name": "SERVICE",   "composite": false, "clientRole": false }
    ]
  },
  "clients": [
    {
      "clientId": "clinica-frontend",
      "name": "Clinica Frontend (Postman/UI)",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {},
      "protocolMappers": [
        {
          "name": "audience-clinica-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "clinica-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "clinica-service",
      "name": "Clinica Service (Feign interno)",
      "enabled": true,
      "publicClient": false,
      "secret": "${KEYCLOAK_SERVICE_SECRET}",
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": false,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {},
      "protocolMappers": [
        {
          "name": "audience-clinica-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "clinica-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@clinica.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "Clinica",
      "requiredActions": [],
      "credentials": [
        { "type": "password", "value": "Admin123!", "temporary": false }
      ],
      "realmRoles": ["ADMIN"]
    },
    {
      "username": "atendente",
      "email": "atendente@clinica.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Ana",
      "lastName": "Atendente",
      "requiredActions": [],
      "credentials": [
        { "type": "password", "value": "Atend123!", "temporary": false }
      ],
      "realmRoles": ["ATENDENTE"]
    },
    {
      "username": "medico",
      "email": "medico@clinica.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Dr",
      "lastName": "Medico",
      "requiredActions": [],
      "credentials": [
        { "type": "password", "value": "Medico123!", "temporary": false }
      ],
      "realmRoles": ["MEDICO"]
    },
    {
      "username": "service-account-clinica-service",
      "enabled": true,
      "serviceAccountClientId": "clinica-service",
      "realmRoles": ["SERVICE"]
    }
  ]
}
